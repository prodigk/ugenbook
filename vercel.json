{
  "functions": {
    "api/book-meta.ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/book/:id", "destination": "/api/book-meta" },
    { "source": "/s/:code", "destination": "/api/book-meta" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
